# ── JagaID Test Environment ────────────────────────────────────────────────────
# Copy this file to .env.test and fill in your TEST Supabase project credentials.
#
# NEVER use production credentials here.
# NEVER commit .env.test to version control (.gitignore already excludes it).
#
# One-time setup:
#   1. Create a second Supabase project at supabase.com — name it "jagaid-test"
#   2. In its SQL Editor, paste and run all migrations in order:
#        supabase/migrations/001_initial_schema.sql
#        supabase/migrations/002_fix_risk_and_constraints.sql
#        supabase/migrations/003_indexes_source_dedup.sql
#   3. Copy this file: cp .env.test.example .env.test
#   4. Fill in the values below from: Supabase Dashboard → jagaid-test → Settings → API
#   5. Run: npm run test:e2e:supabase

# ── Test Supabase project ──────────────────────────────────────────────────────
# Both legacy JWT keys (anon / service_role) and new opaque keys
# (sb_publishable_* / sb_secret_*) are supported.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-or-secret-key

# ── DB mode flags ──────────────────────────────────────────────────────────────
# USE_SUPABASE   — server-only, read at runtime by API routes (db.ts, e2e-seed)
# NEXT_PUBLIC_*  — baked into bundle at build time by Next.js
# Both must be "true" for Supabase mode to work correctly.
USE_SUPABASE=true
NEXT_PUBLIC_USE_SUPABASE=true

# ── Test fixture seed key ──────────────────────────────────────────────────────
# Any random string. Must match E2E_SEED_KEY in your CI secrets.
# Used by /api/e2e-seed (sent via the `x-e2e-key` request header — NOT a query
# string) to insert/remove test fixtures.
# Generate: openssl rand -hex 16
E2E_SEED_KEY=any-random-string-you-choose

# ── Admin key for /admin/upload and /api/admin/* routes ───────────────────────
# Required by the admin upload page e2e tests.
# Sent via the `x-admin-key` request header. Can be any string for testing —
# does not need to match production.
# Generate: openssl rand -hex 16
ADMIN_UPLOAD_KEY=any-admin-key-for-testing
