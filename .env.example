# ─────────────────────────────────────────────────────────────
# JagaID — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project → Settings → API
# Both legacy JWT keys and new opaque keys work:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY    — legacy anon JWT (eyJ...) OR sb_publishable_*
#   SUPABASE_SERVICE_ROLE_KEY        — legacy service_role JWT (eyJ...) OR sb_secret_*
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Service role / secret key — server-side only, NEVER expose to browser.
# This is the only key allowed to insert rows after migration 002 (RLS lockdown).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key-here

# ── App ───────────────────────────────────────────────────────
# Origin used in the WhatsApp share message when window.location.origin
# is not available (e.g. SSR rendering of share URL). Override in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=JagaID

# ── CORS ──────────────────────────────────────────────────────
# Production origin allowed to call /api/* cross-site. Required for any
# domain that's NOT the same origin as the app (e.g. embed widgets).
# Leave UNSET for same-origin only (default; safest).
# Example for production: ALLOWED_ORIGIN=https://jagaid.app
# ALLOWED_ORIGIN=

# ── Rate limiting (NOT YET IMPLEMENTED — placeholder) ─────────
# These vars are reserved for future use. No code reads them today.
# Max lookup requests per IP per minute
# RATE_LIMIT_LOOKUP=30
# Max report submissions per IP per hour
# RATE_LIMIT_REPORT=10

# ── Scraper ───────────────────────────────────────────────────
# Contact email shown in scraper User-Agent header
SCRAPER_CONTACT_EMAIL=contact@jagaid.app

# ── Analytics (optional) ──────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Feature flags ─────────────────────────────────────────────
# USE_SUPABASE (no NEXT_PUBLIC_) — server-side runtime switch for API routes.
# Read at request time by db.ts — NOT baked into the bundle at build time.
# This is the correct way to switch between Supabase and seed data at runtime.
USE_SUPABASE=false

# NEXT_PUBLIC_USE_SUPABASE — baked into the JS bundle at build time.
# Set this for production Vercel builds so the build knows which mode to use.
NEXT_PUBLIC_USE_SUPABASE=false

# ── Admin ─────────────────────────────────────────────────────
# Secret key to access /admin/upload and /api/admin/* routes.
# Sent via the `x-admin-key` request header (or ?admin_key= query param).
# Generate: openssl rand -hex 32
ADMIN_UPLOAD_KEY=your-secret-admin-key-here

# ── E2E Testing ───────────────────────────────────────────────
# Key for /api/e2e-seed — seeds test fixtures before Playwright runs.
# Sent via the `x-e2e-key` request header (no query-param fallback).
# Generate: openssl rand -hex 16
# Set in .env.local for local e2e, and in CI environment variables.
E2E_SEED_KEY=your-e2e-seed-key-here
