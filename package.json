{
  "name": "jagaid",
  "version": "0.1.0",
  "private": true,
  "description": "JagaID — Anti-Fraud Intelligence Platform for Indonesia",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "db:seed": "ts-node --project tsconfig.scripts.json scripts/seed.ts",
    "scrape": "npm run scrape:ojk",
    "scrape:ojk": "ts-node --project tsconfig.scripts.json scripts/scrape-ojk.ts",
    "setup": "bash scripts/setup.sh",
    "reset:db": "ts-node --project tsconfig.scripts.json scripts/reset-db.ts",
    "import:ojk": "ts-node --project tsconfig.scripts.json scripts/import-ojk.ts",
    "data:refresh": "npm run scrape:ojk && npm run import:ojk",
    "test:e2e:supabase": "bash scripts/test-e2e-supabase.sh",
    "test:unit": "jest --passWithNoTests",
    "test:ci": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.5",
    "cheerio": "^1.0.0-rc.12",
    "csv-parse": "^5.6.0",
    "next": "^16.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "dotenv": "^16.4.1",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
